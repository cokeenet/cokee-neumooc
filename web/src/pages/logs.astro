---
/** 执行历史与日志回看（纯 SSR + 详情展开）。 */
import Base from '../layouts/Base.astro';
import AccountTabs from '../components/AccountTabs.astro';
import StatusBadge from 'korikura-webui/components/ui/StatusBadge.astro';
import ErrorState from 'korikura-webui/components/ui/ErrorState.astro';
import LogDetail from '../components/LogDetail.tsx';
import { serverFetchResult } from '../lib/backend';
import type { Account, Execution } from '../lib/api';
import LiveLog from '../components/LiveLog.tsx';
import { execState, fmtTs, jobLabel } from '../lib/labels';

const accRes = await serverFetchResult<Account[]>('/api/accounts');
const accounts = accRes.ok ? accRes.data : [];
const accountId = Number(Astro.url.searchParams.get('account')) || undefined;
// ⚠️ 不能用 `serverFetch(...) ?? []` —— 失败会变成「暂无执行记录」，
// 用户以为没跑过任务，实际是后端不可达。两者下一步动作不同。
const execRes = await serverFetchResult<Execution[]>(
  `/api/executions?limit=40${accountId ? `&account_id=${accountId}` : ''}`,
);
const execs = execRes.ok ? execRes.data : [];
const execError = execRes.ok ? '' : execRes.error;

const labelOf = (id: number) => accounts.find((a) => a.id === id)?.label ?? `#${id}`;

/**
 * 把 `detail` 里那串 JSON 翻成一句人话。
 *
 * 为什么要这么做：刷课成功时 detail 可能是 `{"ok":0,"fail":0,"total":0}` ——
 * 界面显示「成功」，但**一个资源都没处理**。这和「真的刷了 13 个」在表格里
 * 长得一模一样，用户会陷入「反复点、每次都成功、什么都没发生」的困惑。
 * 现在把「成功但无事可做」明确标出来。
 */
function summary(e: Execution): { text: string; quiet: boolean } {
  let d: Record<string, unknown> = {};
  try { d = JSON.parse(e.detail || '{}') as Record<string, unknown>; } catch { /* 非 JSON 原样显示 */ }

  if (e.state === 'failed') return { text: String(d.error ?? '失败（无详情）'), quiet: false };
  if (e.state === 'cancelled') return { text: '已取消', quiet: false };

  const num = (k: string) => (typeof d[k] === 'number' ? (d[k] as number) : null);
  if (num('total') !== null) {
    const total = num('total')!;
    const ok = num('ok') ?? 0;
    const fail = num('fail') ?? 0;
    if (total === 0) {
      // 这条特别重要：成功 ≠ 做了事
      return { text: '没有需要处理的资源（已是最新）', quiet: true };
    }
    return {
      text: `处理 ${total} 个：成功 ${ok}${fail ? ` / 失败 ${fail}` : ''}`,
      quiet: false,
    };
  }
  if (num('new_resources') !== null) {
    const nw = num('new_resources')!;
    const todo = num('todo_resources') ?? 0;
    const tasks = num('pending_tasks') ?? 0;
    const err = d.task_error ? '（作业情况查不到）' : '';
    return {
      text: nw > 0 ? `新发现 ${nw} 个资源，待完成 ${todo}` : `没有新资源，待完成 ${todo}${tasks ? `，作业 ${tasks}` : ''}${err}`,
      quiet: nw === 0 && todo === 0,
    };
  }
  const raw = e.detail && e.detail !== '{}' ? e.detail : '';
  return { text: raw ? raw.slice(0, 80) : '—', quiet: false };
}

// 时间走共享的 fmtTs（内部强制 Asia/Shanghai）。原先这里用裸 toLocaleString，
// 而 SSR 跑在 UTC 容器（TZ 未设置）里 —— 同一次执行在概览页和本页会差 8 小时。
const fmt = fmtTs;
function dur(e: Execution) {
  if (!e.started_at || !e.finished_at) return '—';
  return ((e.finished_at - e.started_at) / 1000).toFixed(1) + 's';
}
---

<Base title="运行日志" description="执行历史">
  <LiveLog client:load accountId={accountId ?? null} />

  <section class="page-head">
    <h1>运行日志</h1>
    <p class="muted">每次执行的记录与结果。进行中的任务可到「刷课」页看实时日志。</p>
  </section>

  <AccountTabs accounts={accounts} current={accountId} path="/logs" />

  <div class="card mt-16">
    {!accRes.ok || execError ? (
      <div class="card">
        <ErrorState text={accRes.ok ? `取不到执行记录：${execError}` : accRes.error} />
        {execError && (
          <p class="muted small" style="text-align:center">
            这是<strong>取不到数据</strong>，不是「没有执行过任务」。
          </p>
        )}
      </div>
    ) : execs.length === 0 ? (
      <div class="empty-state">
        <p class="empty-title">暂无执行记录</p>
        <p class="empty-desc">刷课、同步考勤、签到等任务执行后会记录在这里。</p>
        <a class="btn btn-sm mt-16" href="/study">去刷课</a>
      </div>
    ) : (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>#</th><th>时间</th><th>账号</th><th>任务</th>
              <th>日期</th><th>耗时</th><th>状态</th><th>结果</th>
            </tr>
          </thead>
          <tbody>
            {execs.map((e) => {
              const st = execState(e.state);
              const rs = summary(e);
              return (
                <tr>
                  <td>{e.id}</td>
                  <td>{fmt(e.started_at)}</td>
                  <td>{labelOf(e.account_id)}</td>
                  <td>{jobLabel(e.job_key)}</td>
                  <td class="mono">{e.biz_date}</td>
                  <td>{dur(e)}</td>
                  <td><StatusBadge tone={st.variant} text={st.text} /></td>
                  <td>
                    {rs.quiet ? (
                      <span class="muted">{rs.text}</span>
                    ) : (
                      <span class="sub">{rs.text}</span>
                    )}
                    {/* 诊断入口：完整 detail + 这次执行的逐行日志。
                        这些日志本来只在实时 SSE 里可见，刷新后就再也看不到了。 */}
                    <LogDetail client:visible execId={e.id} detail={e.detail} />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Base>
